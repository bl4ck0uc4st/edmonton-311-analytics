{
  "name": "Edmonton 311 Analytics",
  "dataColors": [
    "#1F6FB2",
    "#E8873A",
    "#2A9D8F",
    "#7B5EA7",
    "#4C9A2A",
    "#C0392B",
    "#8D99AE",
    "#F2C14E",
    "#5C6BC0",
    "#D35400"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F6FB2",
  "good": "#2E8B57",
  "neutral": "#E9A23B",
  "bad": "#C0392B",
  "maximum": "#1F6FB2",
  "center": "#9ECAE9",
  "minimum": "#F5F7FA",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52606D" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E7EB" } }, "radius": 6 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2933" } }, "fontSize": 12, "alignment": "left" }],
        "visualHeader": [{ "show": true }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F5F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E9EDF2" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontSize": 26, "color": { "solid": { "color": "#1F6FB2" } } }],
        "categoryLabels": [{ "show": true, "fontSize": 10, "color": { "solid": { "color": "#52606D" } } }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontSize": 10, "fontColor": { "solid": { "color": "#52606D" } } }],
        "items": [{ "fontSize": 10, "fontColor": { "solid": { "color": "#1F2933" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "showMarker": false }],
        "legend": [{ "show": true, "position": "Top", "fontSize": 9 }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "legend": [{ "show": false }],
        "dataPoint": [{ "fill": { "solid": { "color": "#1F6FB2" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E4E7EB" } }, "rowPadding": 4 }],
        "columnHeaders": [{ "fontSize": 10, "backColor": { "solid": { "color": "#F3F5F8" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E4E7EB" } }, "rowPadding": 4 }],
        "columnHeaders": [{ "fontSize": 10, "backColor": { "solid": { "color": "#F3F5F8" } } }]
      }
    }
  }
}
